# Copy to .env for local development. In deployment, set these as
# Railway environment variables instead — never commit real values.

# Where the database, book files and covers live.
# Local dev: defaults to ./data if unset, no need to set it here.
# Deployment: point it at the mounted volume's path, e.g. /data
# (see the Railway configuration in CLAUDE.md / the deployment notes).
DATA_DIR=./data

# Secret key used to sign session cookies. Required — the app refuses to
# start a session without it. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Maximum size, in MB, accepted for a single uploaded file. Checked while
# streaming the upload to disk, not after the fact — an oversized file is
# rejected by name, like any other invalid file, without ever being fully
# read into memory.
MAX_UPLOAD_SIZE_MB=100
